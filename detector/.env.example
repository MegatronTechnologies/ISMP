ISMP_EDGE_HOST=127.0.0.1
ISMP_EDGE_PORT=8001

# Windows built-in webcam is usually 0. Use 1, 2... for another USB camera.
# An RTSP URL can be used later without changing the application code.
ISMP_CAMERA_SOURCE=0
ISMP_CAMERA_NAME=Windows Built-in Camera
ISMP_CAMERA_BACKEND=AUTO
ISMP_CAMERA_WIDTH=1280
ISMP_CAMERA_HEIGHT=720
ISMP_CAMERA_FPS=30
ISMP_CAMERA_RECONNECT_SECONDS=2

# Temporary MVP model. COCO class 39 is "bottle".
# Replace the model path and target classes when the custom weapon model is ready.
ISMP_YOLO_MODEL=yolov8n.pt
ISMP_YOLO_CLASSES=39
ISMP_YOLO_CONFIDENCE=0.45
ISMP_YOLO_IMAGE_SIZE=640
ISMP_YOLO_DEVICE=cpu
YOLO_CONFIG_DIR=./Ultralytics
MPLCONFIGDIR=./.matplotlib

ISMP_JPEG_QUALITY=82
ISMP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Central backend control plane. Streaming still works if enrollment is blank.
ISMP_CENTRAL_API_URL=http://127.0.0.1:3000/api/v1
ISMP_EDGE_ENROLLMENT_SECRET=
# Leave blank to generate and persist a stable cam-... id in .device.json.
ISMP_CAMERA_ID=
ISMP_EDGE_IDENTITY_FILE=.device.json
ISMP_HEARTBEAT_SECONDS=10
ISMP_CENTRAL_TIMEOUT_SECONDS=5

# Incident noise filtering and evidence capture.
# Confirm 3 positive frames inside 2 seconds, then attach frames at 0s, 1s, 2s.
# Rearm only after 3 seconds without the target and keep a 30-second minimum cooldown.
ISMP_INCIDENT_CONFIRM_FRAMES=3
ISMP_INCIDENT_CONFIRM_WINDOW_SECONDS=2
ISMP_INCIDENT_REARM_ABSENCE_SECONDS=3
ISMP_INCIDENT_COOLDOWN_SECONDS=30
ISMP_INCIDENT_SNAPSHOT_OFFSETS_SECONDS=0,1,2
ISMP_INCIDENT_EVENT_QUEUE_SIZE=16
ISMP_INCIDENT_EVENT_RETRY_SECONDS=2
ISMP_INCIDENT_EVENT_MAX_ATTEMPTS=5
